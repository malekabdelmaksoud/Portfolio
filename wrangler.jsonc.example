{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "melek-portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-21",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "melek-portfolio-content",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "vars": {
    "ADMIN_EMAIL": "melekabdelmaksoud72@gmail.com",
    "AI_MODEL": "@cf/qwen/qwen3.8-27b"
  }
}
